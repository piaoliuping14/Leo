# Runtime artifacts (created at run time — do not commit)
logs/
*.log
lion_clean_exit.txt

# Python 编译缓存
__pycache__/
*.pyc

# 用户配置（首次运行自动生成，含设备绑定信息）
config.json

# IDE / editor local config
.claude/
.vscode/
.idea/
.workbuddy/

# gh CLI 本地配置（含 token，勿提交）
.gh_config/

# OS 生成的元数据文件
Thumbs.db
ehthumbs.db
.DS_Store

# design 目录：只保留运行必需的 文案.txt，忽略其余设计稿/文档/提示词
design/*
!design/文案.txt

# PyInstaller 打包产物
build/
dist/
_libs/